    <constant name="home_category_itemlayout_w">316</constant>
    <constant name="home_category_itemlayout_h">220</constant>
    <!-- Rotated title: anchored at x=40 (left -40 inside the view_pad group) and at the
         card top (16 = top 20 - 4 for a 40px centred line), reading downward. Kodi clips
         the label's pre-rotation rect to the grouplist (x >= 0), so the rect must start at
         the anchor and extend right; a rect centred on x=40 lost the title's first half. -->
    <constant name="home_title_left">-40</constant>
    <constant name="home_title_w">371</constant>
    <constant name="home_title_t">-4</constant>


