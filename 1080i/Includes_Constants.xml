    <!-- Home rows (Rick, 2026-10-18: more poster, less chrome). Kodi's grouplist pitch is
         Size = top + height per child, and a focused row scrolls to the viewport top when
         viewport (1150) = list top (10) + list height. Row pitch is then
         viewport + label top: 1150 - 754 = 396, i.e. a 371px poster plus a 25px gutter.
         The title sits rotated in the 80px left margin, so no header row is reserved.
         New Releases is always the first row (first focusable: Kodi scrolls it to 0), so
         its taller poster is paid for by its own list height, not by the next label. -->
    <constant name="home_row_bump_h">754</constant>
    <constant name="home_row_label_t">-754</constant>
    <constant name="home_row_h">1140</constant>
    <constant name="home_row_offset_y">6</constant>
    <constant name="home_row_busy_t">-64</constant>
    <constant name="home_row_gap_w">16</constant>
