<?xml version="1.0" encoding="UTF-8"?>
<includes>

    <!-- ================================================================== -->
    <!-- RixFlix navigation surfaces (2026-09-11)                             -->
    <!--                                                                     -->
    <!-- Three household complaints, one file:                               -->
    <!--  1. A series page "locked into a single season" - a one-season episode  -->
    <!--     list. Rick: the family only ever wants the SERIES page (all the   -->
    <!--     season tabs). So no route lands on a season page any more: the    -->
    <!--     Recently Watched row opens the series root, a tab's OK drops into  -->
    <!--     that season's episodes (Includes_Views_Combined.xml) instead of    -->
    <!--     opening the season, and the episode row lands on the next          -->
    <!--     unwatched episode (focusepisode.py).                               -->
    <!--  2. The Home hub's Up-bar (Search + Home) exists only on hubs. The  -->
    <!--     nav bar below gives every media window the same Up gesture.     -->
    <!--  3. "No Results" while the search is still running - see            -->
    <!--     Exp_RixFlix_Search_Loading and Includes_Labels.xml.             -->
    <!-- ================================================================== -->

    <!-- Windows built on View_Main that carry the nav bar. -->
    <expression name="Exp_RixFlix_NavBar">[Window.IsVisible(videos) | Window.IsVisible(music) | Window.IsVisible(pictures) | Window.IsVisible(programs) | Window.IsVisible(games)]</expression>

    <!-- The search is still running: the term encoder (310/320) or any result provider
         (501 discover, 502+ the searchwidgets rows) has a directory job in flight. While
         this is true an empty selector (601) means "not answered yet", never "nothing". -->
    <expression name="Exp_RixFlix_Search_Loading">[Container(310).IsUpdating | Container(320).IsUpdating | Container(501).IsUpdating | Container(502).IsUpdating | Container(503).IsUpdating | Container(504).IsUpdating | Container(505).IsUpdating | Container(506).IsUpdating | Container(507).IsUpdating | Container(508).IsUpdating | Container(509).IsUpdating]</expression>

    <!-- Up out of a row view: the nav bar, else the stock views dialog (windows without
         the bar keep the AF3 behaviour). -->
    <include name="RixFlix_Row_OnUp">
        <onup condition="$EXP[Exp_RixFlix_NavBar]">9200</onup>
        <onup condition="!$EXP[Exp_RixFlix_NavBar]">ActivateWindow(1171)</onup>
    </include>

    <!-- Up off the top of a vertical list/wall: the nav bar. With no condition met the
         list keeps Kodi's wrap-around, exactly as before. -->
    <include name="RixFlix_List_OnUp">
        <onup condition="$EXP[Exp_RixFlix_NavBar]">9200</onup>
    </include>

    <!-- ======= -->
    <!-- Nav bar -->
    <!-- ======= -->

    <include name="RixFlix_NavBar_Icon">
        <definition>
            <control type="image">
                <left>$PARAM[left]</left>
                <centertop>50%</centertop>
                <width>40</width>
                <height>40</height>
                <bordersize>icon_home_bordersize</bordersize>
                <texture background="true" colordiffuse="main_fg_30">$PARAM[icon]</texture>
                <visible>!Control.HasFocus($PARAM[id])</visible>
            </control>
            <control type="image">
                <left>$PARAM[left]</left>
                <centertop>50%</centertop>
                <width>40</width>
                <height>40</height>
                <bordersize>icon_home_bordersize</bordersize>
                <texture background="true" colordiffuse="$VAR[ColorSelected]">$PARAM[icon]</texture>
                <visible>Control.HasFocus($PARAM[id])</visible>
            </control>
        </definition>
    </include>

    <include name="RixFlix_NavBar">
        <control type="group">
            <control type="image">
                <include>Home_Fade_Animation</include>
                <visible>ControlGroup(9200).HasFocus()</visible>
                <texture colordiffuse="main_bg_70">special://skin/extras/backgrounds/overlay/combined_topmenu.png</texture>
                <bottom>0</bottom>
            </control>
            <control type="group">
                <include>Home_Group_Definition</include>
                <control type="grouplist" id="9200">
                    <visible allowhiddenfocus="true">ControlGroup(9200).HasFocus()</visible>
                    <include>Home_Fade_Animation</include>
                    <left>-20</left>
                    <height>80</height>
                    <orientation>horizontal</orientation>
                    <itemgap>20</itemgap>
                    <onup>ActivateWindow(1171)</onup>
        <onup condition="$EXP[Exp_RixFlix_NavBar]">9200</onup>
        <onup condition="!$EXP[Exp_RixFlix_NavBar]">ActivateWindow(1171)</onup>
                    <onback>500</onback>

                    <!-- Search box -->
                    <control type="group">
                        <width>480</width>
                        <height>80</height>
                        <control type="button" id="9201">
                            <width>480</width>
                            <height>80</height>
                            <font>font_main</font>
                            <label>Search</label>
                            <textcolor>main_fg_30</textcolor>
                            <focusedcolor>$VAR[ColorSelected]</focusedcolor>
                            <textoffsetx>80</textoffsetx>
                            <align>left</align>
                            <aligny>center</aligny>
                            <texturenofocus colordiffuse="main_fg_12" border="40">common/menu-outlined.png</texturenofocus>
                            <texturefocus colordiffuse="$VAR[ColorHighlight]" border="40">common/menu.png</texturefocus>
                            <!-- One press: the search page WITH its keyboard. The add-on
                                 navigates step by step and proves each step (a built-in
                                 sent blind during an animation is dropped silently). -->
                            <onclick>RunScript(special://home/addons/context.rixflix.gotoshow/opensearch.py)</onclick>
                        </control>
                        <include content="RixFlix_NavBar_Icon">
                            <param name="id">9201</param>
                            <param name="icon">special://skin/extras/icons/search.png</param>
                            <param name="left">20</param>
                        </include>
                    </control>

                    <!-- Home -->
                    <control type="group">
                        <width>80</width>
                        <height>80</height>
                        <control type="button" id="9202">
                            <width>80</width>
                            <height>80</height>
                            <label />
                            <texturenofocus colordiffuse="main_fg_12" border="40">common/menu-outlined.png</texturenofocus>
                            <texturefocus colordiffuse="$VAR[ColorHighlight]" border="40">common/menu.png</texturefocus>
                            <onclick>ActivateWindow(Home)</onclick>
                        </control>
                        <include content="RixFlix_NavBar_Icon">
                            <param name="id">9202</param>
                            <param name="icon">$VAR[Home_Icon_home]</param>
                            <param name="left">20</param>
                        </include>
                    </control>
                </control>
            </control>
        </control>
    </include>
</includes>
