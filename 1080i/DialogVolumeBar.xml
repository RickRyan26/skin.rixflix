<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <zorder>1001</zorder>
    <controls>

        <include content="Furniture_Busy">
            <param name="hasprogress">true</param>
            <param name="icon">$VAR[Image_VolumeIcon]</param>
            <param name="progress">Control.GetLabel(933)</param>
            <param name="progress_id">933</param>
            <param name="mainlabel">$LOCALIZE[13376]</param>
            <param name="minilabel">$INFO[Player.Volume]</param>
            <param name="haslabel">false</param>
            <!-- RixFlix: the loading card means "a video is loading", nothing else. Kodi keeps
                 this dialog open for as long as ITS mute flag is set, and an unmute from the
                 TV/Sonos remote never reaches that flag, so the card stuck on Home. Volume
                 lives on the TV/Sonos (passthrough), so Kodi's volume needs no card. -->
            <param name="visible">false</param>
            <param name="flipspinner">false</param>
            <param name="percentage_label">$INFO[Control.GetLabel(933)]</param>
            <param name="percentage_visible">false</param>
            <param name="visible_condition">!$EXP[Exp_FurnitureBusy_AnimationCond_DialogVolumeBar]</param>
            <param name="windowopen_condition">!$EXP[Exp_FurnitureBusy_AnimationCond_DialogVolumeBar]</param>
        </include>

        <control type="label" id="31">
            <include>Object_Hidden_Item_Definition</include>
        </control>

        <control type="progress" id="933">
            <include>Object_Hidden_Item_Definition</include>
            <info>Player.Volume</info>
        </control>
    </controls>
</window>
