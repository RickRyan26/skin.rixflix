<?xml version="1.0" encoding="UTF-8"?>
<window>
    <zorder>0</zorder>
    <visible>Window.IsActive(VideoFullScreen.xml) | Window.IsActive(MusicVisualisation.xml)</visible>

    <visible>[Player.Paused + [!$EXP[Exp_OSD_DelayInfo_Timing] | !Skin.String(OSD.AutoOnPause,Hide)]] | Player.Caching | Player.Seeking | Player.HasPerformedSeek(2) | Player.Forwarding | Player.Rewinding | !String.IsEmpty(Player.SeekNumeric) | !String.IsEmpty(PVR.ChannelNumberInput) | Window.IsActive(videoosd) | Window.IsActive(musicosd) | Window.IsActive(1140) | Window.IsActive(1141) | Window.IsActive(1142) | Window.IsActive(1143) | Window.IsActive(1144) | Window.IsActive(1145) | Window.IsActive(1146) | Window.IsActive(1147) | Window.IsActive(1148) | Window.IsActive(1149) | Window.IsActive(1152) | Window.IsVisible(videobookmarks) | Window.IsVisible(pvrosdguide) | Window.IsVisible(pvrosdchannels) | [Window.IsVisible(script-cu-lrclyrics-main.xml) + Player.ShowInfo]</visible>

    <visible>!Window.IsActive(DialogSlider.xml)</visible>
    <visible>!Player.HasGame</visible>
    <visible>!Window.IsVisible(DialogPlayerProcessInfo.xml)</visible>

    <animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="300">WindowClose</animation>
    <controls>

        <control type="group">
            <visible>Window.IsActive(VideoFullScreen.xml) | Window.IsActive(MusicVisualisation.xml)</visible>

            <include>OSD_BackgroundFade_Seekbar</include>

            <control type="group">
                <visible>!Window.IsVisible(1152)</visible>
                <include>Animation_OSD_Fullscreen_Change</include>

                <control type="group">
                    <include>Animation_OSD_HideForInfoDialog</include>
                    <control type="group">
                        <include>Animation_OSD_Seekbar_Slide</include>
                        <include>OSD_Progress_Labels</include>
                        <include>OSD_Progress_Bar</include>

                        <control type="group">
                            <include>OSD_HideControls</include>
                            <visible>!Player.Paused</visible>
                            <include content="Furniture_Header">
                                <param name="label">$VAR[Label_OSD_Header]</param>
                                <param name="include_right">false</param>
                                <param name="textcolor">panel_fg_90</param>
                                <param name="top">780</param>
                            </include>
                        </control>

                        <!-- RIXFLIX: compact pause title in the existing lower-third.
                             It adds no card or full-width panel over the picture. -->
                        <control type="group">
                            <visible>Player.Paused + [!String.IsEmpty(VideoPlayer.Title) | !String.IsEmpty(Player.Title)]</visible>
                            <include>OSD_HideControls</include>
                            <left>view_pad</left>
                            <right>view_pad</right>
                            <top>770</top>
                            <height>100</height>
                            <control type="image">
                                <left>0</left>
                                <top>7</top>
                                <width>5</width>
                                <height>70</height>
                                <texture colordiffuse="$VAR[ColorHighlight]">common/white.png</texture>
                            </control>
                            <control type="label">
                                <left>24</left>
                                <right>0</right>
                                <top>0</top>
                                <height>48</height>
                                <align>left</align>
                                <aligny>center</aligny>
                                <font>font_midi_bold</font>
                                <textcolor>panel_fg_100</textcolor>
                                <label>$VAR[Label_RixFlix_PauseTitle]</label>
                            </control>
                            <control type="label">
                                <left>24</left>
                                <right>0</right>
                                <top>46</top>
                                <height>36</height>
                                <align>left</align>
                                <aligny>center</aligny>
                                <font>font_tiny</font>
                                <textcolor>panel_fg_70</textcolor>
                                <label>$VAR[Label_RixFlix_PauseSubTitle]</label>
                            </control>
                        </control>
                    </control>

                    <include content="OSD_CastInfo_HintText">
                        <param name="label">$VAR[Label_OSD_HintText]</param>
                        <param name="visible">[Window.IsActive(videoosd) | Window.IsVisible(1140) | Window.IsVisible(1141) | Window.IsVisible(videobookmarks)] + [!Window.IsVisible(1141) | Skin.String(VideoOSD.PersonCredits.CastCrew,cast)]</param>
                    </include>

                    <include content="OSD_CastInfo_HintText">
                        <param name="label">$LOCALIZE[31346]</param>
                        <param name="visible">Window.IsActive(musicosd) + !Window.IsVisible(1142) + !Window.IsVisible(script-cu-lrclyrics-main.xml)</param>
                    </include>
                </control>

                <include content="Furniture_Header">
                    <param name="include_left">false</param>
                    <param name="textcolor">panel_fg_90</param>
                    <param name="top">60</param>
                </include>

                <control type="group">
                    <top>60</top>
                    <height>80</height>
                    <left>view_pad</left>
                    <control type="image">
                        <top>18</top>
                        <height>44</height>
                        <width>320</width>
                        <aspectratio align="left" aligny="center">keep</aspectratio>
                        <texture>special://skin/media/rixflix/rixflix-wordmark.png</texture>
                    </control>
                </control>


            </control>
        </control>

    </controls>
</window>
