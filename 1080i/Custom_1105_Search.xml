<?xml version="1.0" encoding="UTF-8"?>
<window type="window" id="1105">
    <onload>ClearProperty(Background.ShowOverlay,Home)</onload>
    <!-- Request row upkeep, off the GUI thread: who already requested what, then the title index if due. -->
    <onload>RunPlugin(plugin://plugin.video.rixflix.providers/?mode=request_open)</onload>
    <!-- Back and bottom Down return Home; discard historical list origins. -->
    <onunload>ClearProperty(RixFlix.SearchReturn.Go,Home)</onunload>
    <onunload>ClearProperty(RixFlix.SearchReturn.Window,Home)</onunload>
    <onunload>ClearProperty(RixFlix.SearchReturn.Path,Home)</onunload>
    <onunload>ClearProperty(RixFlix.SearchDown,Home)</onunload>

    <include content="Hub_Onload">
        <param name="window_id">1105</param>
    </include>

    <onunload>ClearProperty(RixFlix.HomeReturn.Go,Home)</onunload>
    <controls>
        <include>Search</include>
    </controls>
</window>
