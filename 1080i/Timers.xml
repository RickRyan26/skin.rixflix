<?xml version="1.0" encoding="UTF-8"?>
<timers>
    <timer>
        <name>rixflix_spotlight_trailer</name>
        <description>Play the selected Home spotlight trailer behind the menu after three idle seconds</description>
        <!-- PARKED OFF BY DEFAULT: cold YouTube resolution is too slow and the surrounding menu UX needs another pass. -->
        <!-- Re-enable only for deliberate testing with Skin.SetBool(RixFlix.EnableAutoplayTrailers). -->
        <!-- Skin timers are parsed before include expressions and therefore cannot use $EXP. -->
        <!-- Start only from Home; the resolver records the signed HLS URL so ownership follows the exact player across every menu window. -->
        <start reset="false">Skin.HasSetting(RixFlix.EnableAutoplayTrailers) + System.IdleTime(3) + String.IsEqual(System.CurrentWindow,Home) + Integer.IsEqual(Window(Home).Property(TMDBHelper.WidgetContainer),301) + [!Integer.IsEqual(Container(301).NumItems,0) | Container(301).IsUpdating] + !Player.HasMedia + !String.IsEmpty(Container(301).ListItem.Trailer) + !String.IsEqual(Window(Home).Property(RixFlix.AutoplayTrailerPlayed),Container(301).ListItem.Trailer)</start>
        <!-- A media player without the exact resolved URL is foreground playback: release ownership without stopping it. -->
        <stop>[Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(rixflix_spotlight_trailer),20) + !Player.HasMedia + !String.IsEmpty(Window(Home).Property(RixFlix.AutoplayTrailer))] | [Player.HasMedia + [String.IsEmpty(Window(Home).Property(RixFlix.AutoplayTrailerResolved)) | !String.IsEqual(Window(Home).Property(RixFlix.AutoplayTrailerResolved),Player.Filenameandpath)]] | [!String.IsEmpty(Container(301).ListItem.Trailer) + !String.IsEqual(Window(Home).Property(RixFlix.AutoplayTrailer),Container(301).ListItem.Trailer)]</stop>
        <onstart>SetProperty(RixFlix.AutoplayTrailer,$ESCINFO[Container(301).ListItem.Trailer],Home)</onstart>
        <onstart>SetProperty(RixFlix.AutoplayTrailerPlayed,$ESCINFO[Container(301).ListItem.Trailer],Home)</onstart>
        <onstart>RunScript(special://skin/scripts/rixflix_trailer.py,$ESCINFO[Container(301).ListItem.Trailer])</onstart>
        <onstop condition="!String.IsEmpty(Window(Home).Property(RixFlix.AutoplayTrailer)) + [!Player.HasMedia | String.IsEqual(Window(Home).Property(RixFlix.AutoplayTrailerResolved),Player.Filenameandpath)]">PlayerControl(Stop)</onstop>
        <onstop>ClearProperty(RixFlix.AutoplayTrailerResolved,Home)</onstop>
        <onstop>ClearProperty(RixFlix.AutoplayTrailer,Home)</onstop>
    </timer>
    <timer>
        <name>rixflix_series_page</name>
        <description>A one-season episode page is never a destination: route it to the series page (all season tabs)</description>
        <!-- Rick, 2026-09-11: "We only want to ever navigate to the series page that has ALL the season tabs." -->
        <!-- Kodi opens videodb://tvshows/titles/SHOW/SEASON/ from any native Select on a season tab, from `..` and from -->
        <!-- older links; a skin cannot intercept a view container's click. This fires the moment such a page shows and -->
        <!-- toseries.py does Container.Update(SHOW ROOT,replace). Excluded: the series page itself (content seasons), -->
        <!-- the all-episodes search path (/-1/-1/), playlists and Recently Added (other prefixes). reset="true": it -->
        <!-- re-arms once the page has changed, so the next stray season page is caught too. -->
        <!-- Skin timers are parsed before include expressions and therefore cannot use $EXP. -->
        <start reset="true">Window.IsActive(videos) + Container.Content(episodes) + String.StartsWith(Container.FolderPath,videodb://tvshows/titles/) + !String.Contains(Container.FolderPath,/-1/-1/) + String.IsEqual(Container.ListItem.DBType,episode) + !Container.IsUpdating</start>
        <stop>!Container.Content(episodes) | !String.StartsWith(Container.FolderPath,videodb://tvshows/titles/)</stop>
        <onstart>RunScript(context.rixflix.gotoshow,toseries)</onstart>
    </timer>
    <timer>
        <name>rixflix_series_land</name>
        <description>The series page opens ON the next episode: the focus drops into the episode row the moment the page is up</description>
        <!-- Rick, 2026-09-12: clicking a series "navigates to the correct view but not the next episode I want to watch". -->
        <!-- Kodi's first-unwatched focus stops at the All Seasons TAB; the row below drew from episode 1 until the viewer -->
        <!-- pressed into it. landseries.py waits for the row to fill, enters it and lands it (focusepisode.py's chooser: -->
        <!-- the episode being resumed, else the one after the last played, else the first unwatched) - one OK plays. -->
        <!-- Runs for the whole visit and stops when the page is left (window, content or path), so it fires ONCE per -->
        <!-- entry - also after playback returns here, which is when the next episode has changed. Container.IsUpdating -->
        <!-- is deliberately NOT a stop: a library refresh under the viewer must not re-land the focus. -->
        <!-- Skin timers are parsed before include expressions and therefore cannot use $EXP. -->
        <start reset="false">Window.IsActive(videos) + Container.Content(seasons) + String.StartsWith(Container.FolderPath,videodb://tvshows/titles/) + !Container.IsUpdating</start>
        <stop>!Window.IsActive(videos) | !Container.Content(seasons) | !String.StartsWith(Container.FolderPath,videodb://tvshows/titles/)</stop>
        <onstart>RunScript(context.rixflix.gotoshow,landseries)</onstart>
    </timer>
    <timer>
        <name>rixflix_search_return</name>
        <description>Back on a nav-bar search returns to the list it was opened from (armed by the search field's onback)</description>
        <!-- The window switch lives here, not in the onback, because a switch inside a movement handler cannot consume -->
        <!-- the Back (CGUIWindow::OnMove) and Kodi's default Back then pops the fresh list to Home - see Includes_Search.xml. -->
        <!-- Skin timers are parsed before include expressions and therefore cannot use $EXP. -->
        <start reset="true">!String.IsEmpty(Window(Home).Property(RixFlix.SearchReturn.Go)) + !String.IsEmpty(Window(Home).Property(RixFlix.SearchReturn.Path)) + Window.IsActive(11105)</start>
        <stop>String.IsEmpty(Window(Home).Property(RixFlix.SearchReturn.Go))</stop>
        <onstart>ReplaceWindow($INFO[Window(Home).Property(RixFlix.SearchReturn.Window)],$INFO[Window(Home).Property(RixFlix.SearchReturn.Path)],return)</onstart>
        <onstart>ClearProperty(RixFlix.SearchReturn.Go,Home)</onstart>
    </timer>
</timers>
