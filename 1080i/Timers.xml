<?xml version="1.0" encoding="UTF-8"?>
<timers>
    <timer>
        <name>rixflix_spotlight_trailer</name>
        <description>Play the selected Home spotlight trailer behind the menu after three idle seconds</description>
        <start reset="true">System.IdleTime(3) + Window.IsActive(home) + $EXP[Hub_Spotlight_Visible_Expression] + !Player.HasMedia + !String.IsEmpty(Container(301).ListItem.Trailer) + !String.IsEqual(Window(Home).Property(RixFlix.AutoplayTrailerPlayed),Container(301).ListItem.Trailer)</start>
        <stop>!Window.IsActive(home) | !$EXP[Hub_Spotlight_Visible_Expression] | String.IsEmpty(Container(301).ListItem.Trailer) | !String.IsEqual(Window(Home).Property(RixFlix.AutoplayTrailer),Container(301).ListItem.Trailer) | [Player.HasMedia + !String.IsEqual(Window(Home).Property(RixFlix.AutoplayTrailer),Player.FileNameAndPath)] | [!Player.HasMedia + !String.IsEmpty(Window(Home).Property(RixFlix.AutoplayTrailer))]</stop>
        <onstart>SetProperty(RixFlix.AutoplayTrailer,$ESCINFO[Container(301).ListItem.Trailer],Home)</onstart>
        <onstart>SetProperty(RixFlix.AutoplayTrailerPlayed,$ESCINFO[Container(301).ListItem.Trailer],Home)</onstart>
        <onstart>PlayMedia($ESCINFO[Container(301).ListItem.Trailer],1,noresume)</onstart>
        <onstop condition="Player.HasMedia + String.IsEqual(Window(Home).Property(RixFlix.AutoplayTrailer),Player.FileNameAndPath)">PlayerControl(Stop)</onstop>
        <onstop>ClearProperty(RixFlix.AutoplayTrailer,Home)</onstop>
    </timer>
</timers>
