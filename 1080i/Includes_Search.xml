<?xml version="1.0" encoding="UTF-8"?>
<includes>



    <!-- SEARCH ON THE STAGE (1.15.0). Rick, 2026-11-11: "The search results page needs to be more
         like the homepage and the category pages in a DRY way. The row title should be on the far
         left and the rows should be closer together", and a focused result shows its details "just
         like they do on the homepage". So Search is the third stage page (Includes_CategoryHub.xml):
           RixFlix_Stage_Backdrop  the focused card's fanart, and its preview
           RixFlix_Stage_Info      Home's Info_Panel for the focused card
           RixFlix_Stage_Rows      Results (502) and Request (540) at Home's pitch
         The field and header show while the field has focus. A focused row hides them and puts the
         query in the page chip, exactly where a category page shows its name. The generated
         searchwidgets includes, the 601 switcher and the TMDb Discover row are no longer used. -->
    <include name="Search">
        <param name="window">1105</param>
        <definition>
            <!-- A numeric target consumes movement before the deferred Home switch. -->
            <include content="Object_Hidden_Button">
                <param name="id">7900</param>
                <onfocus>SetProperty(RixFlix.HomeReturn.Go,1,Home)</onfocus>
                <onback>7900</onback>
            </include>

            <include>Hub_Window_Refocus_Buttons</include>
            <include>RixFlix_Stage_Backdrop</include>
        <!-- 1.16.0 gauntlet: the keyboard sat beside 1200px of empty black. While it is up, the
             first result's fanart fills the right of the stage, faded into the keyboard side
             and into the rows. Not opaque over the whole stage, and only while typing. -->
        <control type="group">
            <visible>Window.IsActive(DialogKeyboard.xml) + $EXP[Exp_RixFlix_Results_Ready] + !String.IsEmpty(Container(502).ListItemAbsolute(0).Art(fanart))</visible>
            <animation effect="fade" start="0" end="100" time="250">Visible</animation>
            <animation effect="fade" start="100" end="0" time="150">Hidden</animation>
            <control type="image">
                <right>0</right><top>0</top><width>1200</width><height>540</height>
                <aspectratio scalediffuse="false" align="right" aligny="top">scale</aspectratio>
                <fadetime>250</fadetime>
                <texture background="true">$INFO[Container(502).ListItemAbsolute(0).Art(fanart)]</texture>
                <animation effect="fade" start="100" end="70" time="0" condition="true">Conditional</animation>
            </control>
            <control type="image">
                <left>720</left><top>0</top><width>700</width><height>540</height>
                <texture colordiffuse="ff080808">rixflix/scrim-left-full.png</texture>
            </control>
            <control type="image">
                <left>720</left><top>300</top><width>1200</width><height>240</height>
                <texture colordiffuse="ff080808">rixflix/fade-bottom.png</texture>
            </control>
        </control>
            <include content="Home_Control">
                <param name="window">$PARAM[window]</param>
                <param name="overlay">[false]</param>
                <onfocus condition="!Skin.HasSetting(HomeSwitcher.Vertical)">SetFocus(3001)</onfocus>
            </include>

            <control type="group">
                <include>Animation_Group_Bumper</include>

                <control type="group">
                    <include condition="Skin.HasSetting(HomeSwitcher.Vertical)">Hub_Window_Side_Slide</include>

                    <!-- Content -->
                    <control type="group" id="400">

                        <control type="group">
                            <!-- The field gives its place to the info panel while a row has focus. -->
                            <visible allowhiddenfocus="true">String.IsEmpty(Window.Property(Searchbar.IsHidden)) + !Window.IsActive(DialogKeyboard.xml) + !ControlGroup(8500).HasFocus</visible>
                            <animation effect="slide" start="0" end="0,-70" condition="Skin.HasSetting(HomeSwitcher.DisableHeader) | Skin.HasSetting(HomeSwitcher.Vertical)">Conditional</animation>
                            <include>Home_Animation</include>
                            <control type="group">
                                <include>Home_Group_Definition</include>
                                <control type="group">
                                    <include>Search_Bar_Defs</include>
                                    <include>Search_Bar_Edit</include>
                                    <include>Search_Bar_Icon</include>
                                    <include>Search_Bar_Help</include>
                                </control>
                                <include condition="!Skin.HasSetting(HomeSwitcher.Vertical)">Home_Switcher_Right_Buttons</include>
                            </control>

                            <include content="Furniture_Header" condition="!Skin.HasSetting(HomeSwitcher.DisableHeader) + !Skin.HasSetting(HomeSwitcher.Vertical)">
                                <param name="label">$VAR[Home_Header_Label]</param>
                            </include>
                        </control>

                        <control type="group">
                            <include>Animation_View_WindowChange</include>
                            <include>Search_Stage</include>
                        </control>
                    </control>

                    <include content="Hub_VertMenu" condition="Skin.HasSetting(HomeSwitcher.Vertical)">
                        <param name="window">$PARAM[window]</param>
                    </include>
                </control>
            </control>
        </definition>
    </include>

    <!-- The stage, Search's part. Results never hides (a hidden list would not load): it fades
         while its items are not for the typed text. Request sits one pitch below; with nothing in
         the library it slides up into the first row's place. OK on a Request card asks Seerr once
         (the provider reloads the row with a chip); a held OK opens the usual Info page. -->
    <include name="Search_Stage">
        <!-- No hero text beside the 628-wide keyboard, and none for the field. -->
        <include content="RixFlix_Stage_Info">
            <param name="visible">ControlGroup(8500).HasFocus + !Window.IsActive(DialogKeyboard.xml)</param>
        </include>
        <include content="RixFlix_Stage_Rows">
            <param name="id">8500</param>
            <param name="onback">7900</param>
            <include content="RixFlix_Stage_Row">
                <param name="id">502</param><param name="group">702</param>
                <param name="label">Results</param>
                <param name="stale">!$EXP[Exp_RixFlix_Results_Ready]</param>
                <include content="RixFlix_Stage_List">
                    <param name="id">502</param>
                    <param name="onback">7900</param>
                    <param name="up">SetFocus(3000)</param>
                    <param name="down">SetFocus(502)</param>
                    <!-- Then on to the Request row when it has titles for this query. -->
                    <ondown condition="$EXP[Exp_RixFlix_Request_Ready]">SetFocus(540)</ondown>
                    <onfocus>ClearProperty(Background.ShowOverlay,Home)</onfocus>
                    <onfocus>ClearProperty(HomeSwitcher.IsVisible,Home)</onfocus>
                    <onfocus>ClearProperty(InfoPanel.FullSwitch,Home)</onfocus>
                    <content sortby="playlist" target="videos" limit="20">$VAR[Path_SearchTerm_Live,plugin://plugin.video.rixflix.providers/?mode=search&amp;live=,]</content>
                </include>
            </include>
            <include content="RixFlix_Stage_Row">
                <param name="id">540</param><param name="group">541</param>
                <param name="label">Request</param>
                <!-- Never a <visible> keyed on list 540's own items: Kodi does not load a hidden
                     container, so the row stayed empty for every query after its first empty
                     answer (theater, 2026-11-10). The stage row fades instead. -->
                <param name="stale">!$EXP[Exp_RixFlix_Request_Ready]</param>
                <animation effect="slide" start="0,0" end="0,-268" time="300" tween="sine" easing="out" condition="$EXP[Exp_RixFlix_Request_Raised]">Conditional</animation>
                <include content="RixFlix_Stage_List">
                    <param name="id">540</param>
                    <param name="onback">7900</param>
                    <param name="up">noop</param>
                    <param name="down">SetFocus(540)</param>
                    <onup condition="$EXP[Exp_RixFlix_Results_Ready]">SetFocus(502)</onup>
                    <onup condition="!$EXP[Exp_RixFlix_Results_Ready]">SetFocus(3000)</onup>
                    <onfocus>ClearProperty(Background.ShowOverlay,Home)</onfocus>
                    <onfocus>ClearProperty(HomeSwitcher.IsVisible,Home)</onfocus>
                    <onfocus>ClearProperty(InfoPanel.FullSwitch,Home)</onfocus>
                    <onclick>RunPlugin($INFO[Container(540).ListItem.FileNameAndPath])</onclick>
                    <content sortby="playlist" target="videos" limit="20">$VAR[Path_RequestSearch]</content>
                </include>
            </include>
        </include>

        <!-- Nothing found, under the field: never while a row has focus or the keyboard is up. -->
        <control type="group">
            <visible>!Window.IsActive(DialogKeyboard.xml) + !ControlGroup(8500).HasFocus + !$EXP[Exp_RixFlix_Results_Ready] + !$EXP[Exp_RixFlix_Request_Ready]</visible>
            <control type="label">
                <font>font_head_bold</font>
                <label>$VAR[Label_Search_Title_NoResults]</label>
                <align>left</align>
                <height>80</height>
                <textcolor>main_fg_90</textcolor>
                <include>Home_Animation</include>
                <left>view_pad</left>
                <top>280</top>
            </control>
            <control type="label">
                <wrapmultiline>true</wrapmultiline>
                <font>font_main_plot</font>
                <label>$VAR[Label_Search_NoResults]</label>
                <align>left</align>
                <height>80</height>
                <textcolor>rix_cinema_muted</textcolor>
                <include>Home_Animation</include>
                <left>view_pad</left>
                <top>360</top>
            </control>
            <!-- loading: the shared busy orbit instead of a "Searching..." sentence -->
            <control type="group">
                <left>view_pad</left>
                <top>370</top>
                <width>60</width>
                <height>60</height>
                <visible>!String.IsEmpty(Control.GetLabel(3000).index(1)) + $EXP[Exp_RixFlix_Search_Loading]</visible>
                <include content="Furniture_Busy_Spinner">
                    <param name="spinspinner">true</param>
                </include>
            </control>
        </control>

        <!-- The page chip names the query while a row has focus; the Request row's one hint sits under it. -->
        <control type="group">
            <visible>ControlGroup(8500).HasFocus + !Window.IsActive(DialogKeyboard.xml)</visible>
            <include content="RixFlix_CategoryTitleChip">
                <param name="label">$INFO[Window(Home).Property(RixFlix.SearchText),Search  •  ]</param>
            </include>
            <control type="label">
                <right>24</right><top>100</top><width>900</width><height>40</height>
                <align>right</align><aligny>center</aligny>
                <font>font_mini_bold</font><textcolor>rix_cinema_paper</textcolor>
                <label>$VAR[Label_Search_Request_Help]</label>
                <visible>Control.HasFocus(540)</visible>
            </control>
        </control>
    </include>

    <include name="Search_Bar_Defs">
        <left>-20</left>
        <width>800</width>
        <height>80</height>
        <centertop>50%</centertop>
    </include>

    <include name="Search_Bar_Edit">

        <!-- Backing Panel -->
        <control type="image">
            <texture colordiffuse="rix_cinema_surface" border="20">common/box.png</texture>
            <visible>!Control.HasFocus(3000)</visible>
        </control>
        <control type="image">
            <texture colordiffuse="rix_cinema_paper" border="20">common/box.png</texture>
            <visible>Control.HasFocus(3000)</visible>
        </control>

        <!-- Edit Control -->
        <control type="button" id="3001">

            <onfocus>ClearProperty(Searchbar.IsHidden)</onfocus>
            <onfocus condition="Skin.HasSetting(HomeSwitcher.Vertical)">ClearProperty(HomeSwitcher.IsVisible,Home)</onfocus>
            <onfocus condition="!Skin.HasSetting(HomeSwitcher.Vertical)">SetProperty(HomeSwitcher.IsVisible,True,Home)</onfocus>

            <onfocus condition="String.IsEmpty(Window.Property(RefocusMenu))">SetFocus(3000)</onfocus>
            <onfocus condition="!String.IsEmpty(Window.Property(RefocusMenu))">SetFocus(300)</onfocus>
            <onfocus>ClearProperty(RefocusMenu)</onfocus>

            <onleft>3000</onleft>
            <onright>3000</onright>
            <onup>3000</onup>
            <ondown>3000</ondown>

            <include>Object_Hidden_Button_Definition</include>
        </control>
        <control type="edit" id="3000">
            <ontextchange>SetProperty(RixFlix.SearchText,$ESCINFO[Control.GetLabel(3000).index(1)],Home)</ontextchange>
            <left>40</left>
            <font>font_main</font>
            <hinttext>Press OK to enter a title</hinttext>
            <textcolor>rix_cinema_muted</textcolor>
            <focusedcolor>rix_cinema_ink</focusedcolor>
            <align>left</align>

            <onleft condition="Skin.HasSetting(HomeSwitcher.Vertical)">SetProperty(RefocusMenu,True)</onleft>
            <onleft condition="Skin.HasSetting(HomeSwitcher.Vertical)">3001</onleft>

            <onright condition="Skin.HasSetting(HomeSwitcher.Vertical)">SetProperty(Bumper.Direction,Right,Home)</onright>
            <onright condition="Skin.HasSetting(HomeSwitcher.Vertical)">ActivateWindow(1180)</onright>


            <onleft condition="!Skin.HasSetting(HomeSwitcher.Vertical)">$INFO[Container(399).ListItem(-1).Property(action)]</onleft>
            <onright condition="!Skin.HasSetting(HomeSwitcher.Vertical)">$INFO[Container(399).ListItem(1).Property(action)]</onright>

            <!-- Up has no target: the TMDb Discover dialog that sat here kept opening (Rick 2026-11-11). -->
            <onup>noop</onup>
            <ondown condition="Integer.IsGreater(Container(502).NumItems,0) + String.IsEqual(Container(502).ListItem.Property(RixFlix.SearchText),Window(Home).Property(RixFlix.SearchText))">502</ondown>
            <!-- A commit leaves 502 empty for ~1.3 s. A Down then is a request for the results, not -->
            <!-- for Home: hold it, and rixflix_search_down lands it on 502 once they arrive. -->
            <ondown condition="$EXP[Exp_RixFlix_Search_Loading]">SetProperty(RixFlix.SearchDown,1,Home)</ondown>
            <ondown condition="[Integer.IsEqual(Container(502).NumItems,0) | !String.IsEqual(Container(502).ListItem.Property(RixFlix.SearchText),Window(Home).Property(RixFlix.SearchText))] + !$EXP[Exp_RixFlix_Search_Loading] + !$EXP[Exp_RixFlix_Request_Ready]">7900</ondown>
            <!-- Nothing in the library, but Seerr has it: Down goes to the Request row, not Home. -->
            <ondown condition="!$EXP[Exp_RixFlix_Results_Ready] + !$EXP[Exp_RixFlix_Search_Loading] + $EXP[Exp_RixFlix_Request_Ready]">SetFocus(540)</ondown>
            <onback>7900</onback>

            <texturefocus />
            <texturenofocus />
        </control>
    </include>

    <include name="Search_Bar_Icon">
        <control type="group">
            <left>0</left>
            <width>80</width>
            <control type="image">
                <include>Home_Grouplist_Icon_Definition</include>
                <texture background="true" colordiffuse="rix_cinema_muted">special://skin/extras/icons/search.png</texture>
                <visible>!Control.HasFocus(3000)</visible>
            </control>
            <control type="image">
                <include>Home_Grouplist_Icon_Definition</include>
                <texture background="true" colordiffuse="rix_cinema_ink">special://skin/extras/icons/search.png</texture>
                <visible>Control.HasFocus(3000)</visible>
            </control>
        </control>
    </include>


    <include name="Search_Bar_Help">
        <control type="label">
            <top>95</top>
            <left>40</left>
            <width>760</width>
            <height>50</height>
            <font>font_tiny</font>
            <label>Enter part of a title, choose Done, then browse the results</label>
            <textcolor>rix_cinema_muted</textcolor>
            <align>left</align>
            <visible>String.IsEmpty(Control.GetLabel(3000).index(1))</visible>
        </control>
    </include>


</includes>
