<?xml version="1.0" encoding="UTF-8"?>
<window>
    <zorder>1000</zorder>
    <!-- 1.12.19: Kodi's start wait (GUI_MSG_PLAYBACK_STARTED -> CGUIDialogBusy::WaitOnEvent)
         opens this MODAL dialog for every Home hover preview until AV start, and a modal
         takes every action first: a Up/Down/Left/Right or OK pressed in that ~0.2-0.7 s was
         lost (Rick 2026-10-20 16:15). The focused hidden button hands the press to Home
         while an owned preview sits under the dialog; Action(<a>,home) is TMSG_GUI_ACTION to
         that window only, run synchronously in the busy loop. No onback: Back still reaches
         CGUIDialogBusy::OnBack (the resident's dismissal and the keymap's forwarder). -->
    <defaultcontrol always="true">9100</defaultcontrol>
    <controls>

        <include content="Furniture_Busy">
            <param name="hasspinner">true</param>
            <param name="spinspinner">true</param>
            <param name="icon">special://skin/media/rixflix/rix-badge.png</param>
            <param name="haslabel">false</param>
            <param name="visible">!$EXP[Exp_RixFlix_PreviewStarting]</param>
            <param name="visible_condition">!$EXP[Exp_FurnitureBusy_AnimationCond_DialogBusy]</param>
            <param name="windowopen_condition">!$EXP[Exp_FurnitureBusy_AnimationCond_DialogBusy]</param>
        </include>

        <control type="progress" id="10">
            <include>Object_Hidden_Button_Definition</include>
        </control>

        <control type="button" id="9100">
            <include>Object_Hidden_Button_Definition</include>
            <onup condition="$EXP[Exp_RixFlix_PreviewUnderBusy] + Window.IsActive(home)">Action(Up,home)</onup>
            <onup condition="$EXP[Exp_RixFlix_PreviewUnderBusy] + Window.IsActive(11101)">Action(Up,1101)</onup>
            <onup condition="$EXP[Exp_RixFlix_PreviewUnderBusy] + Window.IsActive(11138)">Action(Up,1138)</onup>
            <ondown condition="$EXP[Exp_RixFlix_PreviewUnderBusy] + Window.IsActive(home)">Action(Down,home)</ondown>
            <ondown condition="$EXP[Exp_RixFlix_PreviewUnderBusy] + Window.IsActive(11101)">Action(Down,1101)</ondown>
            <ondown condition="$EXP[Exp_RixFlix_PreviewUnderBusy] + Window.IsActive(11138)">Action(Down,1138)</ondown>
            <onleft condition="$EXP[Exp_RixFlix_PreviewUnderBusy] + Window.IsActive(home)">Action(Left,home)</onleft>
            <onleft condition="$EXP[Exp_RixFlix_PreviewUnderBusy] + Window.IsActive(11101)">Action(Left,1101)</onleft>
            <onleft condition="$EXP[Exp_RixFlix_PreviewUnderBusy] + Window.IsActive(11138)">Action(Left,1138)</onleft>
            <onright condition="$EXP[Exp_RixFlix_PreviewUnderBusy] + Window.IsActive(home)">Action(Right,home)</onright>
            <onright condition="$EXP[Exp_RixFlix_PreviewUnderBusy] + Window.IsActive(11101)">Action(Right,1101)</onright>
            <onright condition="$EXP[Exp_RixFlix_PreviewUnderBusy] + Window.IsActive(11138)">Action(Right,1138)</onright>
            <!-- Action's window argument is the skin's own id (1101), a condition's is Kodi's (11101).
                 Only while the preview is still the player: a Select stops it first (FIFO
                 before its Action(Select)), so a second OK into a pending movie play's busy
                 dialog stays swallowed instead of starting the title twice. -->
            <onclick condition="$EXP[Exp_RixFlix_PreviewUnderBusy] + $EXP[Exp_RixFlix_PreviewPlaying] + Window.IsActive(home)">Action(Select,home)</onclick>
            <onclick condition="$EXP[Exp_RixFlix_PreviewUnderBusy] + $EXP[Exp_RixFlix_PreviewPlaying] + Window.IsActive(11101)">Action(Select,1101)</onclick>
            <onclick condition="$EXP[Exp_RixFlix_PreviewUnderBusy] + $EXP[Exp_RixFlix_PreviewPlaying] + Window.IsActive(11138)">Action(Select,1138)</onclick>
        </control>

    </controls>
</window>
