<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <zorder>1000</zorder>
    <controls>

        <include content="Furniture_Busy">
            <param name="hasprogress">true</param>
            <param name="spinspinner">Window.IsActive(DialogBusy.xml)</param>
            <param name="icon">special://skin/media/rixflix/rix-badge.png</param>
            <param name="progress">Control.GetLabel(32)</param>
            <param name="progress_id">32</param>
            <param name="minilabel">$INFO[Control.GetLabel(31)]</param>
            <param name="mainlabel">$INFO[Control.GetLabel(30)]</param>
            <!-- RixFlix: background jobs (jellyfin-kodi sync, TMDb Helper lookups) report here
                 with item titles and people; in the loading card they read as a stuck load.
                 The card is for a loading video only (DialogBusy). -->
            <param name="visible">false</param>
            <param name="visible_condition">!$EXP[Exp_FurnitureBusy_AnimationCond_DialogExtendedProgressBar]</param>
            <param name="windowopen_condition">!$EXP[Exp_FurnitureBusy_AnimationCond_DialogExtendedProgressBar]</param>
            <param name="percentage_label">$INFO[Control.GetLabel(32), - ,%]</param>
            <param name="percentage_visible">true</param>
        </include>

        <control type="label" id="31">
            <include>Object_Hidden_Item_Definition</include>
        </control>
        <control type="label" id="30">
            <include>Object_Hidden_Item_Definition</include>
        </control>
        <control type="progress" id="32">
            <include>Object_Hidden_Item_Definition</include>
            <info>Player.Progress</info>
        </control>
    </controls>
</window>
