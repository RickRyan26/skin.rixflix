            <align>center</align><aligny>center</aligny>
            <font>font_main_bold</font><textcolor>main_fg_70</textcolor>
            <label>Loading genres…</label>
            <visible>!String.IsEqual(Window(Home).Property(RixFlix.CategoryReady),Window(Home).Property(RixFlix.Category))</visible>
        </control>
