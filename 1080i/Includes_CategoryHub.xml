<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <include name="RixFlix_CategoryHub_Reload"><description>Reload key only</description></include>

    <!-- THE STAGE (1.14.0): Home's landscape-row format for every sub page. Rick 2026-11-11: the
         category pages and Coming Soon "replicate the homepage's landscape posters rows format
         with the video information above". One definition serves both pages:
           RixFlix_Stage_Backdrop  the focused title's fanart, and the hover preview behind it
           RixFlix_Stage_Info      Home's Info_Panel for the focused card
           RixFlix_Stage_Rows      the row stack, exactly two Home pitches tall
           RixFlix_Stage_Row       one List_Premiere_Row (Home's own landscape list)
           RixFlix_PageLoading     the pulsing RixFlix wordmark
         Bare Container. is the window's focused container (CGUIInfoManager::GetActiveContainer:
         a non-media window uses its focused control), so one backdrop and one info panel follow
         whichever row has focus. Layout reasoning: docs/cinema.md "The stage". -->
    <variable name="Image_RixFlix_StageArt">
        <value condition="!String.IsEmpty(Container.ListItem.Art(fanart))">$INFO[Container.ListItem.Art(fanart)]</value>
        <value condition="!String.IsEmpty(Container.ListItem.Art(tvshow.fanart))">$INFO[Container.ListItem.Art(tvshow.fanart)]</value>
        <value>$INFO[Container.ListItem.Art(landscape)]</value>
    </variable>

    <variable name="Image_RixFlix_InfoArt">
        <value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(tvshow.fanart))">$INFO[ListItem.Art(tvshow.fanart)]</value>
    </variable>

    <include name="RixFlix_Stage_Backdrop">
        <!-- Only while nothing plays. Kodi 22 draws opaque textures in a first, depth-writing pass
             and punches the video hole with a quad at the far plane (CGUIVideoControl::Render), so a
             fully opaque image BEHIND the video window wins the depth test and the preview is a black
             box with sound (Rick, Coming Soon, 2026-11-11). Home has nothing behind its video window. -->
        <control type="image">
            <texture colordiffuse="ff080808">common/white.png</texture>
            <visible>$EXP[Exp_Video_IsNotPlaying]</visible>
        </control>
        <!-- Home's own preview box: a cached trailer plays here once the card has had its dwell,
             and Background_NotVideo fades the fanart out over it (the poster "rotates" to the trailer). -->
        <include content="Background_Video_FlixArt">
            <param name="w">home_preview_w</param>
            <param name="h">home_preview_h</param>
        </include>
        <include content="Background_FlixArt">
            <param name="texture">$VAR[Image_RixFlix_StageArt]</param>
            <param name="flixart_size_w">home_preview_w</param>
            <param name="flixart_size_h">home_preview_h</param>
            <param name="diffuse">diffuse/flixart/flixart_new.png</param>
        </include>
        <include>Background_Main_Overlay</include>
        <!-- 1.16.0 gauntlet: text over bright art was unreadable (the runtime ran off the haze into
             a white sky), and the art ended in a hard cut at the first card row. Translucent, so
             both also lie over a playing preview without closing its video hole. -->
        <control type="image">
            <left>0</left><top>0</top><width>1240</width><height>540</height>
            <texture colordiffuse="ff000000">rixflix/scrim-left.png</texture>
        </control>
        <control type="image">
            <left>0</left><top>330</top><width>1920</width><height>210</height>
            <texture colordiffuse="ff080808">rixflix/fade-bottom.png</texture>
        </control>
    </include>

    <include name="RixFlix_PageLoading">
        <param name="id">8988</param>
        <definition>
            <control type="image" id="$PARAM[id]">
                <left>660</left><top>460</top><width>600</width><height>160</height>
                <aspectratio>keep</aspectratio>
                <texture>special://skin/media/rixflix/rixflix-wordmark.png</texture>
                <visible>$PARAM[visible]</visible>
                <animation effect="fade" start="45" end="100" time="900" tween="sine" easing="inout" pulse="true" condition="true">Conditional</animation>
            </control>
        </definition>
    </include>

    <include name="RixFlix_Stage_Empty">
        <control type="label">
            <left>0</left><top>500</top><width>1920</width><height>80</height>
            <align>center</align><aligny>center</aligny>
            <font>font_main_bold</font><textcolor>main_fg_70</textcolor>
            <label>$PARAM[label]</label>
            <visible>$PARAM[visible]</visible>
        </control>
    </include>

    <!-- Home's row panel (Hub_Combined_Info): logo, facts, source line, plot, "Ends at". The
         poster-row budget (tagline + 2 lines) ends at y500, clear of the first card at y552. -->
    <include name="RixFlix_Stage_Info">
        <param name="visible">true</param>
        <definition>
            <control type="group">
                <visible>!$EXP[Exp_InfoDialogs] + [$PARAM[visible]]</visible>
                <height>540</height>
                <include>Info_Panel_Dimensions</include>
                <include content="Info_Panel">
                    <param name="container">Container.</param>
                    <!-- The resident publishes RixFlix.Plot.RowPoster for a library card; any other card (Coming Soon) falls back to its own ListItem.Plot inside the same include. -->
                    <param name="home_plot">true</param>
                    <param name="home_plot_variant">RowPoster</param>
                    <param name="home_plot_max_h">120</param>
                    <param name="home_plot_max_h_heading">80</param>
                </include>
            </control>
        </definition>
    </include>

    <!-- Two Home pitches (243px art + 25px gutter each): GUIControlGroupList scrolls a focused
         child to a viewport edge, so only a whole number of pitches stops on a row boundary. -->
    <include name="RixFlix_Stage_Rows">
        <param name="onback">PreviousMenu</param>
        <definition>
            <control type="grouplist" id="$PARAM[id]">
                <left>0</left><top>stage_rows_t</top><width>1920</width><height>stage_rows_h</height>
                <orientation>vertical</orientation><itemgap>0</itemgap>
                <scrolltime tween="quadratic">300</scrolltime><onback>$PARAM[onback]</onback>
                <!-- Without these, GUIControlGroupList wraps its first and last rows, so a sparse page's edge row would wrap. -->
                <onup>noop</onup><ondown>noop</ondown>
                <nested />
            </control>
        </definition>
    </include>

    <include name="RixFlix_Stage_Row">
        <param name="visible">true</param>
        <param name="stale">false</param>
        <param name="label" />
        <param name="onback">PreviousMenu</param>
        <definition>
            <control type="group" id="$PARAM[group]">
                <height>category_row_h</height>
                <visible>$PARAM[visible]</visible>
                <!-- Fade, never hide: a hidden row would not load the content that clears this. Start 100: when the condition clears, Kodi plays the fade back to its start alpha, so start="0" stays black. -->
                <animation effect="fade" start="100" end="0" time="200" condition="$PARAM[stale]">Conditional</animation>
                <control type="label">
                    <left>40</left><top>0</top><width>home_premiere_item_h</width><height>40</height>
                    <angle>-90</angle><align>left</align><aligny>center</aligny>
                    <font>font_mini_bold</font><label>$PARAM[label]</label><textcolor>white</textcolor>
                    <animation effect="fade" start="100" end="70" time="150" condition="!Control.HasFocus($PARAM[id])">Conditional</animation>
                </control>
                <!-- The caller's RixFlix_Stage_List. Kodi fills <nested /> only as a DIRECT child of a definition's top node (CGUIIncludes::InsertNested). 1.14.0 put it inside the list include here, one level deeper: no row got its <content>, every list stayed empty and the page could not take focus (theater, 2026-11-11 02:09). -->
                <nested />
            </control>
        </definition>
    </include>

    <!-- Home's landscape list for one stage row. The include is the definition's top node, so its <nested /> is direct and the caller's <content>/<onclick> reach the list. -->
    <include name="RixFlix_Stage_List">
        <param name="onback">PreviousMenu</param>
        <definition>
            <!-- Move through the row group, not list to list: a hidden group passes the move on, and the grouplist would refocus this row. -->
            <include content="List_Premiere_Row">
                <param name="id">$PARAM[id]</param>
                <top>category_list_t</top><width>1856</width><height>home_premiere_itemlayout_h</height>
                <preloaditems>0</preloaditems>
                <onup>$PARAM[up]</onup><ondown>$PARAM[down]</ondown>
                <onback>$PARAM[onback]</onback>
                <nested />
            </include>
        </definition>
    </include>

    <include name="RixFlix_Category_Row">
        <definition>
            <include content="RixFlix_Stage_Row">
                <param name="id">81$PARAM[n]</param>
                <param name="group">82$PARAM[n]</param>
                <param name="label">$PARAM[label]</param>
                <param name="visible">String.IsEqual(Window(Home).Property(RixFlix.CategoryReady),Window(Home).Property(RixFlix.Category)) + Integer.IsGreater(Window(Home).Property(RixFlix.CategoryCount.$PARAM[key]),2)</param>
                <param name="stale">!String.IsEqual(Window(Home).Property(RixFlix.CategoryRow.$PARAM[key]),Window(Home).Property(RixFlix.Category))</param>
                <include content="RixFlix_Stage_List">
                    <param name="id">81$PARAM[n]</param>
                    <param name="up">$PARAM[up]</param>
                    <param name="down">$PARAM[down]</param>
                    <param name="onback">8900</param>
                    <!-- No dynamic target: node.target on each native item owns navigation. -->
                    <content limit="5000">plugin://plugin.video.rixflix.providers/?mode=category_genre&amp;cat=$INFO[Window(Home).Property(RixFlix.Category)]&amp;genre=$PARAM[query]</content>
                </include>
            </include>
        </definition>
    </include>

    <!-- Back for every stage page. A window switch inside a control's onback lets Kodi apply a
         second, default Back to the window it lands on (Timers.xml, rixflix_home_return). So Back
         only focuses this button; a timer sees the property and makes the switch. -->
    <include name="RixFlix_Stage_Return">
        <control type="button" id="8900">
            <visible allowhiddenfocus="true">false</visible>
            <onfocus>SetProperty(RixFlix.CategoryReturn.Go,1,Home)</onfocus>
            <onback>8900</onback>
        </control>
    </include>

    <include name="RixFlix_CategoryHub">
        <include>RixFlix_Stage_Backdrop</include>
        <include>RixFlix_Stage_Return</include>
        <!-- Always load this tiny manifest, even when every genre row is hidden. -->
        <control type="list" id="8999">
            <left>-10</left><width>1</width><height>1</height><enable>false</enable>
            <itemlayout width="1" height="1" /><focusedlayout width="1" height="1" />
            <content>plugin://plugin.video.rixflix.providers/?mode=category_manifest&amp;cat=$INFO[Window(Home).Property(RixFlix.Category)]</content>
        </control>
        <control type="button" id="8901">
            <visible allowhiddenfocus="true">false</visible>
            <onup>8100</onup><ondown>8100</ondown><onleft>8100</onleft><onright>8100</onright>
            <onback>8900</onback>
        </control>
        <include content="RixFlix_PageLoading">
            <param name="id">8988</param>
            <param name="visible">!String.IsEqual(Window(Home).Property(RixFlix.CategoryReady),Window(Home).Property(RixFlix.Category))</param>
        </include>
        <include content="RixFlix_Stage_Empty">
            <param name="label">No genre has enough titles yet.</param>
            <param name="visible">String.IsEqual(Window(Home).Property(RixFlix.CategoryReady),Window(Home).Property(RixFlix.Category)) + Integer.IsEqual(Window(Home).Property(RixFlix.CategoryRows),0)</param>
        </include>
        <include content="RixFlix_Stage_Info">
            <param name="visible">String.IsEqual(Window(Home).Property(RixFlix.CategoryReady),Window(Home).Property(RixFlix.Category))</param>
        </include>
        <include content="RixFlix_Stage_Rows">
            <param name="id">8100</param>
            <param name="onback">8900</param>
                <include content="RixFlix_Category_Row">
                    <param name="n">01</param><param name="key">Action</param><param name="label">Action</param><param name="query">Action</param>
                    <param name="up">noop</param><param name="down">8202</param>
                </include>
                <include content="RixFlix_Category_Row">
                    <param name="n">02</param><param name="key">Adventure</param><param name="label">Adventure</param><param name="query">Adventure</param>
                    <param name="up">8201</param><param name="down">8203</param>
                </include>
                <include content="RixFlix_Category_Row">
                    <param name="n">03</param><param name="key">Animation</param><param name="label">Animation</param><param name="query">Animation</param>
                    <param name="up">8202</param><param name="down">8204</param>
                </include>
                <include content="RixFlix_Category_Row">
                    <param name="n">04</param><param name="key">Comedy</param><param name="label">Comedy</param><param name="query">Comedy</param>
                    <param name="up">8203</param><param name="down">8205</param>
                </include>
                <include content="RixFlix_Category_Row">
                    <param name="n">05</param><param name="key">Crime</param><param name="label">Crime</param><param name="query">Crime</param>
                    <param name="up">8204</param><param name="down">8206</param>
                </include>
                <include content="RixFlix_Category_Row">
                    <param name="n">06</param><param name="key">Documentary</param><param name="label">Documentary</param><param name="query">Documentary</param>
                    <param name="up">8205</param><param name="down">8207</param>
                </include>
                <include content="RixFlix_Category_Row">
                    <param name="n">07</param><param name="key">Drama</param><param name="label">Drama</param><param name="query">Drama</param>
                    <param name="up">8206</param><param name="down">8208</param>
                </include>
                <include content="RixFlix_Category_Row">
                    <param name="n">08</param><param name="key">Family</param><param name="label">Family</param><param name="query">Family</param>
                    <param name="up">8207</param><param name="down">8209</param>
                </include>
                <include content="RixFlix_Category_Row">
                    <param name="n">09</param><param name="key">Fantasy</param><param name="label">Fantasy</param><param name="query">Fantasy</param>
                    <param name="up">8208</param><param name="down">8210</param>
                </include>
                <include content="RixFlix_Category_Row">
                    <param name="n">10</param><param name="key">Horror</param><param name="label">Horror</param><param name="query">Horror</param>
                    <param name="up">8209</param><param name="down">8211</param>
                </include>
                <include content="RixFlix_Category_Row">
                    <param name="n">11</param><param name="key">Mystery</param><param name="label">Mystery</param><param name="query">Mystery</param>
                    <param name="up">8210</param><param name="down">8212</param>
                </include>
                <include content="RixFlix_Category_Row">
                    <param name="n">12</param><param name="key">Romance</param><param name="label">Romance</param><param name="query">Romance</param>
                    <param name="up">8211</param><param name="down">8213</param>
                </include>
                <include content="RixFlix_Category_Row">
                    <param name="n">13</param><param name="key">ScienceFiction</param><param name="label">Science Fiction</param><param name="query">Science%20Fiction</param>
                    <param name="up">8212</param><param name="down">8214</param>
                </include>
                <include content="RixFlix_Category_Row">
                    <param name="n">14</param><param name="key">Thriller</param><param name="label">Thriller</param><param name="query">Thriller</param>
                    <param name="up">8213</param><param name="down">noop</param>
                </include>
        </include>
        <include>RixFlix_CategoryTitleChip</include>
    </include>
    <include name="RixFlix_CategoryTitleChip">
        <param name="label">$INFO[Window(Home).Property(RixFlix.CategoryLabel)]</param>
        <definition>
        <!-- Fixed over the rows, so it comes last. A button is the one control whose background follows its label's width, and the grouplist's right alignment keeps its right edge fixed. The first button is the shadow: same label and font, 40px larger every way, like Texture_Shadow_40. Disabled, so neither can take focus. -->
        <control type="grouplist">
            <right>4</right><top>-10</top><width>1000</width><height>156</height>
            <orientation>horizontal</orientation><align>right</align><itemgap>0</itemgap>
            <control type="button">
                <width>auto</width><height>156</height><enable>false</enable>
                <textoffsetx>76</textoffsetx><font>font_head_bold</font>
                <textcolor>00000000</textcolor><disabledcolor>00000000</disabledcolor>
                <texturenofocus colordiffuse="shadow_hard" border="60">shadows/shadow-40.png</texturenofocus>
                <texturefocus colordiffuse="shadow_hard" border="60">shadows/shadow-40.png</texturefocus>
                <label>$PARAM[label]</label>
            </control>
        </control>
        <control type="grouplist">
            <right>44</right><top>30</top><width>1000</width><height>76</height>
            <orientation>horizontal</orientation><align>right</align><itemgap>0</itemgap>
            <control type="button">
                <width>auto</width><height>76</height><enable>false</enable>
                <textoffsetx>36</textoffsetx><font>font_head_bold</font>
                <textcolor>white</textcolor><disabledcolor>white</disabledcolor>
                <!-- 1.16.0: no box. A filled chip read as a button that cannot be pressed. -->
                <texturenofocus />
                <texturefocus />
                <label>$PARAM[label]</label>
            </control>
        </control>
        </definition>
    </include>
</includes>
