        <control type="list" id="8999">
            <left>-10</left><width>1</width><height>1</height><enable>false</enable>
            <itemlayout width="1" height="1" /><focusedlayout width="1" height="1" />
            <content>plugin://plugin.video.rixflix.providers/?mode=category_manifest&amp;cat=$INFO[Window(Home).Property(RixFlix.Category)]</content>
        </control>
