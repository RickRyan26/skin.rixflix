<include content="Widget_Row">
    <!-- Landscape rows use a 268px pitch; poster rows retain 396px. -->
    <param name="widgetheight">{widget_home_height}</param>
    <param name="labeltop">{widget_home_labeltop}</param>
    <param name="inline_label">true</param>
    <param name="inline_label_top">home_title_t</param>
    <param name="busy_top">home_row_busy_t</param>
    <param name="id">{widget_id}</param>
    <param name="groupid">{widget_group_id}</param>
    <param name="label">{widget_label}</param>
    <param name="usewidgetlabel">{widget_usewidgetlabel}</param>
    <param name="include">{widget_home_include}</param>
    <param name="grouplistid">{grouplist_id}</param>
    <param name="refocus">{grouplist_refocus}</param>
    <param name="detailed">{widget_detailed}</param>
    <param name="visible">[{widget_category_visible}] + [{widget_visible}]</param>
    <param name="altvisible">{widget_altvisible}</param>
    <param name="busy_isupdating">{widget_busy_isupdating}</param>
    <param name="widgetfade_include">{widget_widgetfade_include}</param>
    <!-- Rows below the focused one stay at full strength (more poster on screen);
         they still dim behind the spotlight's Play button. -->
    <param name="widgetfade_disable">![$EXP[Exp_Hubs_Spotlight_SlideDown]]</param>
    <param name="widgetconstants_affix">{widgetconstants_affix}</param>

    <!-- Rows above the focused one fade out as the grouplist scrolls them away. The clip
         starts 16px above the focused cards, and the previous row's progress/count badges
         hang ~25px below its cards, so without this their rims show as arcs over the row.
         Row ids are 501 + index inside grouplist {grouplist_id}; the spotlight is outside it.
         Under a modal (Options opened by Down off the last row) System.CurrentControlId is the
         dialog's 7xxx control, above every row id, so every row - the focused one too - faded
         out behind the dialog. There, Home's own last-focused row (WidgetContainer) decides. -->
    <animation effect="fade" start="100" end="0" time="200" condition="ControlGroup({grouplist_id}).HasFocus + [[!System.HasActiveModalDialog + Integer.IsGreater(System.CurrentControlId,{widget_id})] | [System.HasActiveModalDialog + Integer.IsGreater(Window.Property(TMDbHelper.WidgetContainer),{widget_id})]]">Conditional</animation>

    <onfocus>ClearProperty(HomeSwitcher.IsVisible,Home)</onfocus>
    <onfocus>ClearProperty(InfoPanel.FullSwitch,Home)</onfocus>

    <description>{description}</description>

    <include content="Widget_NoResults">
        <param name="id">{widget_id}</param>
    </include>

    <content sortby="{widget_sortby}" sortorder="{widget_sortorder}" target="{widget_target}" limit="{widget_limit}" browse="$VAR[Defs_BrowseLimitedLists]">{widget_path}</content>

    <include content="Defs_AutoScroll" condition="{widget_isautoscroll}">
        <param name="condition">[!Control.HasFocus({widget_id}) | System.IdleTime(3)]</param>
    </include>

    {widget_custom_onclick}
    {widget_custom_onfocus}
    {widget_custom_content}

</include>