<contents>
    <rules name="widget_include">
        <rule>
            <condition>{item_widget_style}==Premiere</condition>
            <value>List_Premiere_Row</value>
        </rule>
        <rule>
            <condition>{item_widget_style}==PremiereFull</condition>
            <value>List_Premiere_Row</value>
        </rule>
        <rule>
            <condition>{item_widget_style}==Category</condition>
            <value>List_Category_Row</value>
        </rule>
        <rule>
            <condition>{item_widget_style}==Landscape</condition>
            <value>List_Landscape_Row</value>
        </rule>
        <rule>
            <condition>{item_widget_style}==Poster</condition>
            <value>List_Poster_Row</value>
        </rule>
        <rule>
            <condition>{item_widget_style}==Square</condition>
            <value>List_Square_Row</value>
        </rule>
        <rule>
            <condition>{item_widget_style}==Circle</condition>
            <value>List_Circle_Row</value>
        </rule>
        <rule>
            <condition>{item_widget_style}==Board</condition>
            <value>List_Board_Row</value>
        </rule>
        <rule>
            <condition>{item_widget_style}==Card</condition>
            <value>List_Card_Row</value>
        </rule>
        <rule>
            <condition>True</condition>
            <value>List_Landscape_Row</value>
        </rule>
    </rules>
    <!-- Home only (widgets_row.xmltemplate). widget_include stays the shared mapping
         that search rows also use. -->
    <rules name="widget_home_include">
        <rule>
            <condition>{item_widget_style}==Premiere</condition>
            <value>List_Premiere_Row</value>
        </rule>
        <rule>
            <condition>{item_widget_style}==PremiereFull</condition>
            <value>List_Premiere_Row</value>
        </rule>
        <rule>
            <condition>{item_widget_style}==Category</condition>
            <value>List_Category_Row</value>
        </rule>
        <rule>
            <condition>{item_widget_style}==Landscape</condition>
            <value>List_Landscape_Row</value>
        </rule>
        <rule>
            <condition>{item_widget_style}==Poster</condition>
            <value>List_Home_Poster_Row</value>
        </rule>
        <rule>
            <condition>{item_widget_style}==Square</condition>
            <value>List_Square_Row</value>
        </rule>
        <rule>
            <condition>{item_widget_style}==Circle</condition>
            <value>List_Circle_Row</value>
        </rule>
        <rule>
            <condition>{item_widget_style}==Board</condition>
            <value>List_Board_Row</value>
        </rule>
        <rule>
            <condition>{item_widget_style}==Card</condition>
            <value>List_Card_Row</value>
        </rule>
        <rule>
            <condition>True</condition>
            <value>List_Landscape_Row</value>
        </rule>
    </rules>
    <rules name="widget_home_height">
        <rule>
            <condition>{item_widget_style}==Premiere</condition>
            <value>home_premiere_row_h</value>
        </rule>
        <rule>
            <condition>True</condition>
            <value>home_row_h</value>
        </rule>
    </rules>
    <rules name="widget_home_labeltop">
        <rule>
            <condition>{item_widget_style}==Premiere</condition>
            <value>home_premiere_label_t</value>
        </rule>
        <rule>
            <condition>{item_widget_style}==PremiereFull</condition>
            <value>home_premiere_label_t</value>
        </rule>
        <!-- The first poster row after the landscape rows (1.12.48): its label spacer sets
             only the distance from the row above (the list is viewport-height, so focus
             still scrolls it to the same origin), so it takes the landscape 25px gutter. -->
        <rule>
            <condition>{item_widget_labeltop}==Premiere</condition>
            <value>home_premiere_label_t</value>
        </rule>
        <rule>
            <condition>True</condition>
            <value>home_row_label_t</value>
        </rule>
    </rules>
    <!-- Home info-panel plot budget per row style (Rick 2026-11-11: plots ran into the
         Continue rows). Every Home card ends at y887 (validate_cinema), so a poster row's
         cards start at y516 and a landscape row's at y644; the panel starts at y60.
         Poster: tagline + 2 lines, Ends-at bottom y500. Landscape: 5 lines, bottom y580.
         The variant names must match quality.py PLOT_VARIANTS (line totals 3 and 5). -->
    <rules name="widget_home_plot_variant">
        <rule>
            <condition>{item_widget_style}==Poster</condition>
            <value>RowPoster</value>
        </rule>
        <rule>
            <condition>True</condition>
            <value>Row</value>
        </rule>
    </rules>
    <rules name="widget_home_plot_max_h">
        <rule>
            <condition>{item_widget_style}==Poster</condition>
            <value>120</value>
        </rule>
        <rule>
            <condition>True</condition>
            <value>200</value>
        </rule>
    </rules>
    <rules name="widget_home_plot_max_h_heading">
        <rule>
            <condition>{item_widget_style}==Poster</condition>
            <value>80</value>
        </rule>
        <rule>
            <condition>True</condition>
            <value>160</value>
        </rule>
    </rules>
</contents>
